{
  "name": "trailmark",
  "private": true,
  "description": "Trailmark monorepo: web app (apps/web), Android + iOS app with Expo (apps/mobile), shared code (packages/core).",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "web": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "mobile": "npm --prefix apps/mobile run start",
    "typecheck": "npm --prefix apps/web run typecheck && npm --prefix apps/mobile run typecheck",
    "seed:owner": "node scripts/seed-owner.mjs",
    "db:push": "supabase db push",
    "fn:deploy": "supabase functions deploy delete-account",
    "prepare": "husky || true",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@supabase/supabase-js": "^2.45.4",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "supabase": "^2.0.0",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=22.13"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": "eslint --max-warnings=0"
  }
}
